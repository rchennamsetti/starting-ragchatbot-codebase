# Copy this file to .env and add your actual API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Logging level: DEBUG, INFO, WARNING, or ERROR (default: INFO)
# A background thread polls this file for changes and applies a new
# LOG_LEVEL to the running app within a few seconds - no restart needed.
LOG_LEVEL=INFO

# Log file path, relative to backend/ (default: ./logs/app.log)
# Rotates at 5 MB, keeping up to 5 backup files.
LOG_FILE=./logs/app.log